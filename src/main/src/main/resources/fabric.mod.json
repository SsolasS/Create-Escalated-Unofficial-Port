{
  "schemaVersion": 1,
  "id": "escalated",
  "version": "${version}",
  "name": "Create: Escalated",
  "description": "Bringing you to higher places in your Create mod builds",
  "authors": [
    "rbasamoyai"
  ],
  "license": "MIT",
  "icon": "icon.png",

  "environment": "*",

  "entrypoints": {
    "main": [
